# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Project Settings → Database → Connection string → Transaction pooler
# (use the pooled connection, required for serverless/Vercel)
DATABASE_URL=

# Note: the Google OAuth Client ID / Secret are NOT app env vars — paste them
# directly into the Supabase dashboard under Authentication → Providers →
# Google. The Next.js app never needs them.